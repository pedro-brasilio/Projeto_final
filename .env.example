# Copie este arquivo para .env e preencha as chaves. NUNCA versione o .env.

# OpenAI / endpoint compatível com a Responses API
OPENAI_API_KEY=

# OMDb (detalhes de filmes/séries) - https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# TMDB (listas de estreias/populares e busca em pt-BR) - https://www.themoviedb.org/settings/api
# Basta uma: a chave v3 OU o token de leitura v4.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# IGDB (jogos) - autenticação via OAuth da Twitch.
# Crie um aplicativo em https://dev.twitch.tv/console/apps e use as credenciais.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# CheapShark (promoções e comparação de preços de jogos de PC).
# A API é pública e hoje NÃO exige chave. A base fica configurável e o campo de
# chave já existe caso isso mude no futuro.
CHEAPSHARK_API_URL=https://www.cheapshark.com/api/1.0
CHEAPSHARK_SITE_URL=https://www.cheapshark.com
CHEAPSHARK_TIMEOUT_MS=9000
# A CheapShark bloqueia User-Agent genérico. Opcional: personalize a identificação.
# CHEAPSHARK_USER_AGENT=MinhaApp/1.0 (contato@exemplo.com)
# CHEAPSHARK_API_KEY=

# Conversão de preços para Real (a CheapShark só devolve USD). Cotação USD->BRL
# buscada automaticamente; estas variáveis são só ajuste fino / plano B.
# USD_BRL_URL=https://economia.awesomeapi.com.br/last/USD-BRL
# USD_BRL_FALLBACK=5.40

# Histórico de conversas (persistido em arquivo, sem banco de dados).
# Opcional. Padrão: ./data/history.json
# No Render, aponte para um caminho dentro de um Persistent Disk para que o
# histórico não seja perdido em cada deploy/reinício (ex.: /var/data/history.json).
HISTORY_FILE=
